<Window x:Class="TothBoost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TothBoost — Otimizador de Desempenho para Jogos (Windows 11)"
        Width="1320" Height="820" WindowStartupLocation="CenterScreen"
        FontSize="13" Background="{StaticResource Bg0}">

    <Border Background="{StaticResource Bg0}">
    <DockPanel>

        <!-- ===== Topo ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2E1065" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="TB" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TOTHBOOST" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Otimização de desempenho para jogos · Windows 10/11" FontSize="11.5" Foreground="{StaticResource TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="BadgeAdmin" Background="#7F1D1D" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtBadgeAdmin" Text="ADMINISTRADOR" FontWeight="Bold" FontSize="11" Foreground="White"/>
                    </Border>
                    <Border x:Name="BadgeBaseline" Background="#14532D" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtBadgeBaseline" Text="Linha de base: —" FontWeight="SemiBold" FontSize="11" Foreground="White"/>
                    </Border>
                    <Border x:Name="BadgeRestore" Background="#2E1065" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtBadgeRestore" Text="Ponto de restauração: —" FontWeight="SemiBold" FontSize="11" Foreground="White"/>
                    </Border>
                    <Button x:Name="BtnRestoreAll" Style="{StaticResource BtnRed}" Content="Restaurar tudo (linha de base)" Click="BtnRestoreAll_Click" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Abas ===== -->
        <TabControl x:Name="Tabs" Margin="12,10,12,6" SelectedIndex="0">

            <!-- ============ PROCESSOS ============ -->
            <TabItem Header="Processos">
                <DockPanel Margin="0,8,0,0">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBox x:Name="ProcSearch" Width="260" TextChanged="ProcSearch_TextChanged" ToolTip="Buscar por nome"/>
                            <TextBlock x:Name="ProcCount" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <Separator Width="24"/>
                            <Button x:Name="BtnProcSelectAll" Style="{StaticResource BtnPrimary}" Content="Selecionar tudo (selecionáveis)" Click="BtnProcSelectAll_Click" ToolTip="Marca todos os processos que você pode encerrar — os protegidos do sistema ficam de fora"/>
                            <Button x:Name="BtnProcKillSel" Style="{StaticResource BtnRed}" Content="Encerrar selecionados" Click="BtnProcKillSel_Click" ToolTip="Encerra processos selecionados (os protegidos ficam bloqueados)"/>
                            <Button x:Name="BtnProcRestartSel" Style="{StaticResource BtnPrimary}" Content="Reiniciar selecionados" Click="BtnProcRestartSel_Click"/>
                            <CheckBox x:Name="ChkAutoRefresh" Content="Atualização automática (2s)" VerticalAlignment="Center" Margin="12,0,0,0" IsChecked="True" Checked="AutoRefreshChanged" Unchecked="AutoRefreshChanged"/>
                            <Button x:Name="BtnProcRefresh" Style="{StaticResource BtnPrimary}" Content="Atualizar" Click="BtnProcRefresh_Click"/>
                        </WrapPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SEUS PROCESSOS — você pode encerrar ou reiniciar" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
                            <DataGrid x:Name="GridProcesses" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True" MaxHeight="380" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Ações" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource BtnRed}" FontSize="11" Padding="6,3" Margin="0,0,4,0" Click="ProcRowKill_Click" IsEnabled="{Binding IsProtected, Converter={StaticResource InverseBool}}" ToolTip="Encerrar processo">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Encerrar" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource BtnPrimary}" FontSize="11" Padding="6,3" Click="ProcRowRestart_Click" ToolTip="Reiniciar processo">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Reiniciar" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" IsEnabled="{Binding IsProtected, Converter={StaticResource InverseBool}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" SortMemberPath="Pid"/>
                                    <DataGridTextColumn Header="Processo" Binding="{Binding Name}" Width="190" SortMemberPath="Name"/>
                                    <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="70" SortMemberPath="P.CpuPercent"/>
                                    <DataGridTextColumn Header="Memória (MB)" Binding="{Binding MemMb}" Width="95" SortMemberPath="MemMb"/>
                                    <DataGridTextColumn Header="GPU" Binding="{Binding GpuText}" Width="65"/>
                                    <DataGridTextColumn Header="Leitura" Binding="{Binding ReadText}" Width="85"/>
                                    <DataGridTextColumn Header="Gravação" Binding="{Binding WriteText}" Width="90"/>
                                    <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="*"/>
                                    <DataGridTemplateColumn Header="Proteção" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProtectionLabel}" Foreground="{Binding ProtectionColor}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Background="{StaticResource Bg1}" CornerRadius="8" Padding="10,8" Margin="0,20,0,6">
                                <TextBlock Text="PROCESSOS DO SISTEMA — PROTEGIDOS (não podem ser encerrados)" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Red}"/>
                            </Border>
                            <DataGrid x:Name="GridProcSystem" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True" MaxHeight="280" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" IsEnabled="{Binding IsProtected, Converter={StaticResource InverseBool}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" SortMemberPath="Pid"/>
                                    <DataGridTextColumn Header="Processo" Binding="{Binding Name}" Width="190" SortMemberPath="Name"/>
                                    <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="70" SortMemberPath="P.CpuPercent"/>
                                    <DataGridTextColumn Header="Memória (MB)" Binding="{Binding MemMb}" Width="95" SortMemberPath="MemMb"/>
                                    <DataGridTextColumn Header="GPU" Binding="{Binding GpuText}" Width="65"/>
                                    <DataGridTextColumn Header="Leitura" Binding="{Binding ReadText}" Width="85"/>
                                    <DataGridTextColumn Header="Gravação" Binding="{Binding WriteText}" Width="90"/>
                                    <DataGridTextColumn Header="Caminho" Binding="{Binding Path}" Width="*"/>
                                    <DataGridTemplateColumn Header="Proteção" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProtectionLabel}" Foreground="{Binding ProtectionColor}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============ INICIALIZAÇÃO ============ -->
            <TabItem Header="Inicialização">
                <DockPanel Margin="0,8,0,0">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBox x:Name="StartupSearch" Width="260" TextChanged="StartupSearch_TextChanged" ToolTip="Buscar"/>
                            <TextBlock x:Name="StartupCount" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <Separator Width="24"/>
                            <Button x:Name="BtnStartupDisableSel" Style="{StaticResource BtnGreen}" Content="Desabilitar selecionados" Click="BtnStartupDisableSel_Click"/>
                            <Button x:Name="BtnStartupEnableSel" Style="{StaticResource BtnPrimary}" Content="Habilitar selecionados" Click="BtnStartupEnableSel_Click"/>
                            <Button x:Name="BtnStartupRefresh" Style="{StaticResource BtnPrimary}" Content="Atualizar" Click="BtnStartupRefresh_Click"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="GridStartup" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Ações" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=OneWay}" Click="StartupRowToggle_Click" ToolTip="{Binding State}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="260" SortMemberPath="Name"/>
                            <DataGridTextColumn Header="Local" Binding="{Binding Location}" Width="260"/>
                            <DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="520"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock DockPanel.Dock="Bottom" Text="Nada é excluído: desabilitar move o valor/atalho para a pasta de segurança do TothBoost; habilitar devolve tudo ao lugar original." FontSize="11" Foreground="{StaticResource TextDim}" Margin="2,8,2,0" TextWrapping="Wrap"/>
                </DockPanel>
            </TabItem>

            <!-- ============ SERVIÇOS ============ -->
            <TabItem Header="Serviços">
                <DockPanel Margin="0,8,0,0">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBox x:Name="SvcSearch" Width="260" TextChanged="SvcSearch_TextChanged" ToolTip="Buscar por nome"/>
                            <ComboBox x:Name="SvcFilter" Width="230" SelectionChanged="SvcFilter_SelectionChanged" Margin="8,0,0,0"/>
                            <TextBlock x:Name="SvcCount" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <Separator Width="24"/>
                            <Button x:Name="BtnSvcDisableSel" Style="{StaticResource BtnGreen}" Content="Desabilitar selecionados" Click="BtnSvcDisableSel_Click"/>
                            <Button x:Name="BtnSvcEnableSel" Style="{StaticResource BtnPrimary}" Content="Habilitar selecionados" Click="BtnSvcEnableSel_Click"/>
                            <Button x:Name="BtnSvcStopSel" Style="{StaticResource BtnPrimary}" Content="Parar selecionados" Click="BtnSvcStopSel_Click"/>
                            <Button x:Name="BtnSvcStartSel" Style="{StaticResource BtnPrimary}" Content="Iniciar selecionados" Click="BtnSvcStartSel_Click"/>
                            <Button x:Name="BtnSvcGaming" Style="{StaticResource BtnAccent}" Content="Perfil de jogos (serviços recomendados)" Click="BtnSvcGaming_Click" FontWeight="SemiBold"/>
                            <Button x:Name="BtnSvcRefresh" Style="{StaticResource BtnPrimary}" Content="Atualizar" Click="BtnSvcRefresh_Click"/>
                        </WrapPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="SERVIÇOS QUE VOCÊ PODE GERENCIAR" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
                            <DataGrid x:Name="GridServices" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Ações" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanTouch}" Click="SvcRowToggle_Click" ToolTip="{Binding ToggleTip}"/>
                                                    <Button Content="Parar" Width="52" Style="{StaticResource BtnPrimary}" FontSize="11" Padding="6,3" Margin="6,0,0,0" Click="SvcRowStop_Click" ToolTip="Apenas parar agora (não altera a inicialização)"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" IsEnabled="{Binding CanTouch}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Serviço" Binding="{Binding Name}" SortMemberPath="Name" Width="150"/>
                                    <DataGridTextColumn Header="Nome de exibição" Binding="{Binding DisplayName}" SortMemberPath="DisplayName" Width="220"/>
                                    <DataGridTextColumn Header="Inicialização" Binding="{Binding KindStartLabel}" SortMemberPath="KindStartLabel" Width="110"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding RunningState}" Width="100"/>
                                    <DataGridTextColumn Header="Classificação" Binding="{Binding RiskLabel}" SortMemberPath="RiskLabel" Width="150"/>
                                    <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="120"/>
                                    <DataGridTextColumn Header="Descrição / Motivo" Binding="{Binding Description}" Width="340"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Background="{StaticResource Bg1}" CornerRadius="8" Padding="10,8" Margin="0,20,0,6">
                                <TextBlock Text="SERVIÇOS DO SISTEMA — PROTEGIDOS (desativar pode causar BSOD)" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Red}"/>
                            </Border>
                            <DataGrid x:Name="GridSvcSystem" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" IsEnabled="{Binding CanTouch}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Serviço" Binding="{Binding Name}" SortMemberPath="Name" Width="150"/>
                                    <DataGridTextColumn Header="Nome de exibição" Binding="{Binding DisplayName}" SortMemberPath="DisplayName" Width="220"/>
                                    <DataGridTextColumn Header="Inicialização" Binding="{Binding KindStartLabel}" SortMemberPath="KindStartLabel" Width="110"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding RunningState}" Width="100"/>
                                    <DataGridTextColumn Header="Classificação" Binding="{Binding RiskLabel}" SortMemberPath="RiskLabel" Width="150"/>
                                    <DataGridTextColumn Header="Categoria" Binding="{Binding Category}" Width="120"/>
                                    <DataGridTextColumn Header="Descrição / Motivo" Binding="{Binding Description}" Width="340"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ============ TAREFAS AGENDADAS ============ -->
            <TabItem Header="Tarefas Agendadas">
                <DockPanel Margin="0,8,0,0">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBox x:Name="TaskSearch" Width="260" TextChanged="TaskSearch_TextChanged" ToolTip="Buscar"/>
                            <TextBlock x:Name="TaskCount" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <Separator Width="24"/>
                            <Button x:Name="BtnTaskDisableSel" Style="{StaticResource BtnGreen}" Content="Desabilitar selecionadas" Click="BtnTaskDisableSel_Click"/>
                            <Button x:Name="BtnTaskEnableSel" Style="{StaticResource BtnPrimary}" Content="Habilitar selecionadas" Click="BtnTaskEnableSel_Click"/>
                            <Button x:Name="BtnTaskRefresh" Style="{StaticResource BtnPrimary}" Content="Atualizar" Click="BtnTaskRefresh_Click"/>
                        </WrapPanel>
                    </Border>
                    <DataGrid x:Name="GridTasks" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Ações" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=OneWay}" Click="TaskRowToggle_Click" ToolTip="{Binding State}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tarefa" Binding="{Binding Name}" Width="260" SortMemberPath="Name"/>
                            <DataGridTextColumn Header="Caminho completo" Binding="{Binding FullPath}" Width="430"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="110"/>
                            <DataGridTextColumn Header="Autor" Binding="{Binding Author}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ PERFIL (movido para depois de Ajustes) ============ -->
            <TabItem Header="Ajustes">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Ajustes raros (todos reversíveis)" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <DataGrid x:Name="GridTweaks" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" MaxHeight="620">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Ações" Width="160">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Aplicar" Style="{StaticResource BtnGreen}" FontSize="11" Padding="6,3" Margin="0,0,4,0" Click="TweakApply_Click"/>
                                                        <Button Content="Reverter" Style="{StaticResource BtnPrimary}" FontSize="11" Padding="6,3" Click="TweakRevert_Click"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Ajuste" Binding="{Binding Name}" Width="260"/>
                                        <DataGridTextColumn Header="Descrição" Binding="{Binding Description}" Width="470"/>
                                        <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ PERFIL ============ -->
            <TabItem Header="Perfil">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <TextBlock Text="SEUS PERFIS" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                                        <TextBlock Text="Perfil atual: " Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                                        <TextBlock x:Name="TxtCurrentProfile" Text="—" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <Button x:Name="BtnViewToggle" Style="{StaticResource BtnPrimary}" Content="Ver como lista" Click="BtnViewToggle_Click" ToolTip="Alterna entre exibição em cards e em lista"/>
                                        <Button x:Name="BtnProfileCreate" Style="{StaticResource BtnAccent}" Content="Criar novo perfil" Click="BtnProfileCreate_Click" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="O Default é o save total: guarda o estado original da máquina (a referência). Para qualquer outra configuração, crie seus próprios perfis — você pode sobrescrever o perfil que escolher ou ir salvando em novos." Margin="0,8,0,0" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>

                                <ItemsControl x:Name="ProfileCards" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,12,12" Width="296">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Background="#2E1065" CornerRadius="8" Width="36" Height="36">
                                                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                                                            <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{StaticResource Accent}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding CreatedText}" Margin="0,8,0,0" FontSize="11.5" Foreground="{StaticResource TextDim}"/>
                                                    <TextBlock Text="{Binding LastSavedText}" FontSize="11.5" Foreground="{StaticResource TextDim}"/>
                                                    <TextBlock Text="EM USO AGORA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Green}" Margin="0,6,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <WrapPanel Margin="0,10,0,0">
                                                        <Button Content="Usar" Style="{StaticResource BtnPrimary}" FontSize="11" Padding="10,4" Click="BtnProfileUse_Click"/>
                                                        <Button Content="Salvar aqui" Style="{StaticResource BtnGreen}" FontSize="11" Padding="10,4" Margin="8,0,0,0" Click="BtnProfileSaveHere_Click"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DataGrid x:Name="GridProfiles" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" Visibility="Collapsed" MaxHeight="320">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Perfil" Binding="{Binding Name}" Width="180"/>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding KindLabel}" Width="300"/>
                                        <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="120"/>
                                        <DataGridTextColumn Header="Último salvamento" Binding="{Binding LastSavedText}" Width="180"/>
                                        <DataGridTemplateColumn Header="Situação" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="EM USO" FontWeight="Bold" Foreground="{StaticResource Green}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Ações" Width="220">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Usar" Style="{StaticResource BtnPrimary}" FontSize="11" Padding="10,4" Click="BtnProfileUse_Click"/>
                                                        <Button Content="Salvar aqui" Style="{StaticResource BtnGreen}" FontSize="11" Padding="10,4" Margin="8,0,0,0" Click="BtnProfileSaveHere_Click"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="BtnSaveProfile" Style="{StaticResource BtnGreen}" Content="Salvar estado atual no perfil selecionado" Click="BtnSaveProfile_Click" FontWeight="Bold"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="SEGURANÇA TOTAL — NADA É EXCLUÍDO" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Green}"/>
                                <TextBlock Text="Na PRIMEIRA abertura neste computador, o TothBoost cria OBRIGATORIAMENTE um ponto de restauração do Windows e grava o perfil Default (save total): o estado original de TODOS os serviços, tarefas agendadas, inicialização e ajustes — antes de você poder modificar qualquer coisa. Nada é excluído e tudo pode ser restaurado com 1 clique." Margin="0,8,0,0" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Restaurar tudo (linha de base)" Style="{StaticResource BtnRed}" Click="BtnRestoreAll_Click" FontWeight="Bold"/>
                                    <Button x:Name="BtnRefreshTweaks" Style="{StaticResource BtnPrimary}" Content="Atualizar estado" Click="BtnRefreshTweaks_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="PONTOS DE RESTAURAÇÃO DO WINDOWS" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                <TextBlock Text="Lista com data e hora exata de cada ponto. Excluir um ponto é POR CONTA E RISCO do usuário — o Windows pode recusar a exclusão do ponto mais recente." Margin="0,8,0,0" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                                <DataGrid x:Name="GridRestorePoints" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" MaxHeight="260" Margin="0,10,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ponto" Binding="{Binding Description}" Width="*"/>
                                        <DataGridTextColumn Header="Data e hora" Binding="{Binding WhenText}" Width="180"/>
                                        <DataGridTemplateColumn Header="Ações" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Excluir" Style="{StaticResource BtnRed}" FontSize="11" Padding="10,4" Click="BtnRestorePointDelete_Click" ToolTip="Exclui este ponto — por conta e risco do usuário"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="TxtRestorePointInfo" Text="" Margin="0,8,0,0" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="BtnCreateRestorePoint" Style="{StaticResource BtnPrimary}" Content="Criar ponto de restauração agora" Click="BtnCreateRestorePoint_Click"/>
                                    <Button x:Name="BtnRefreshRestorePoints" Style="{StaticResource BtnPrimary}" Content="Atualizar lista" Click="BtnRefreshRestorePoints_Click" Margin="8,0,0,0"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Como funciona" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,0,0,4">
                                    <Run Text="1.) Na primeira abertura, o TothBoost cria OBRIGATORIAMENTE um ponto de restauração do Windows e grava o perfil Default: save total do estado original (serviços, tarefas, inicialização e ajustes) — nunca sobrescreve perfis existentes."/>
                                    <LineBreak/>
                                    <Run Text="2.) Serviços marcados como "/><Run Text="CRÍTICO" FontWeight="Bold" Foreground="{StaticResource Red}"/><Run Text=" (drivers do kernel e núcleo do Windows) não podem ser tocados — desativá-los causaria tela azul (BSOD)."/>
                                    <LineBreak/>
                                    <Run Text="3.) Para cada serviço/tarefa/inicialização você pode habilitar e desabilitar à vontade, individualmente ou em lote. Qualquer estado pode virar um perfil: salve no perfil que quiser — recomendamos não mexer no Default, que é a referência original."/>
                                    <LineBreak/>
                                    <Run Text="4.) Um único clique restaura TODOS os serviços, tarefas, inicializações e ajustes para o estado original do Default (linha de base)."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" Text="Pronto."/>
                <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="180" Height="4" Visibility="Collapsed" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="Nada é excluído — tudo é reversível" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>
    </DockPanel>
    </Border>
</Window>