<Window x:Class="TothBoost.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TothBoost — Windows 10/11 Performance Optimizer for Gaming"
        Width="1320" Height="820" WindowStartupLocation="CenterScreen"
        FontSize="13" Background="{StaticResource Bg0}">

    <Border Background="{StaticResource Bg0}">
    <DockPanel>

        <!-- ===== Header ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2E1065" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="TB" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TOTHBOOST" FontSize="19" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Gaming Performance Optimization · Windows 10/11" FontSize="11.5" Foreground="{StaticResource TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCheckUpdate" Style="{StaticResource BtnAccent}" Content="🔄 Check Updates" Click="BtnCheckUpdate_Click" Margin="0,0,10,0" Padding="10,5" FontSize="11"/>
                    <Border x:Name="BadgeAdmin" Background="#7F1D1D" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtBadgeAdmin" Text="ADMINISTRATOR" FontWeight="Bold" FontSize="11" Foreground="White"/>
                    </Border>
                    <Border x:Name="BadgeBaseline" Background="#14532D" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtBadgeBaseline" Text="BASELINE SAVED" FontWeight="Bold" FontSize="11" Foreground="White"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Status Footer ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,8">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource TextDim}" FontSize="12"/>
        </Border>

        <!-- ===== Main Navigation Tabs ===== -->
        <TabControl x:Name="Tabs" Margin="12,10,12,6" SelectedIndex="0">

            <!-- ============ PROCESSES ============ -->
            <TabItem Header="Processes">
                <DockPanel Margin="0,8,0,0">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBox x:Name="ProcSearch" Width="260" TextChanged="ProcSearch_TextChanged" ToolTip="Search process by name"/>
                            <TextBlock x:Name="ProcCount" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <Separator Width="24"/>
                            <Button x:Name="BtnProcSelectAll" Style="{StaticResource BtnPrimary}" Content="Select All (Killable)" Click="BtnProcSelectAll_Click" ToolTip="Selects all visible non-protected processes"/>
                            <Button x:Name="BtnProcKillSel" Style="{StaticResource BtnRed}" Content="Terminate Selected" Click="BtnProcKillSel_Click" ToolTip="Terminates selected processes (protected processes remain locked)"/>
                            <Button x:Name="BtnProcRestartSel" Style="{StaticResource BtnPrimary}" Content="Restart Selected" Click="BtnProcRestartSel_Click"/>
                            <CheckBox x:Name="ChkAutoRefresh" Content="Auto-refresh (2s)" VerticalAlignment="Center" Margin="12,0,0,0" IsChecked="True" Checked="AutoRefreshChanged" Unchecked="AutoRefreshChanged"/>
                            <Button x:Name="BtnProcRefresh" Style="{StaticResource BtnPrimary}" Content="Refresh Now" Click="BtnProcRefresh_Click"/>
                            <Button x:Name="BtnProcColumns" Style="{StaticResource BtnPrimary}" Content="Columns ▾" Click="ColumnsButton_Click" Tag="{Binding ElementName=GridProcesses}" ToolTip="Choose which columns are visible"/>
                        </WrapPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                        <Button x:Name="BtnProcViewToggle" Style="{StaticResource BtnAccent}" Content="Switch to System Processes" Click="BtnProcViewToggle_Click" Padding="12,6" HorizontalAlignment="Left"/>
                    </Border>

                    <TextBlock x:Name="ProcViewHeader" DockPanel.Dock="Top" Text="USER PROCESSES — Safe to terminate or restart" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,2,0,6"/>
                    <DataGrid x:Name="GridProcesses" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Actions" Width="150" CanUserSort="False" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource BtnRed}" FontSize="11" Padding="6,3" Margin="0,0,4,0" Click="ProcRowKill_Click" IsEnabled="{Binding IsProtected, Converter={StaticResource InverseBool}}" ToolTip="Terminate process">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Kill" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource BtnPrimary}" FontSize="11" Padding="6,3" Click="ProcRowRestart_Click" ToolTip="Restart process">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Restart" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="36" CanUserSort="False" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" IsEnabled="{Binding IsProtected, Converter={StaticResource InverseBool}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" SortMemberPath="Pid"/>
                                    <DataGridTextColumn Header="Process Name" Binding="{Binding Name}" Width="190" SortMemberPath="Name"/>
                                    <DataGridTextColumn Header="Session" Binding="{Binding Session}" Width="80" SortMemberPath="Session"/>
                                    <DataGridTextColumn Header="RAM (MB)" Binding="{Binding MemText}" Width="95" SortMemberPath="MemMb"/>
                                    <DataGridTextColumn Header="CPU %" Binding="{Binding CpuText}" Width="80" SortMemberPath="CpuValue"/>
                                    <DataGridTextColumn Header="GPU %" Binding="{Binding GpuText}" Width="80" SortMemberPath="GpuValue"/>
                                    <DataGridTextColumn Header="Disk Read" Binding="{Binding ReadText}" Width="100" SortMemberPath="ReadKbs"/>
                                    <DataGridTextColumn Header="Disk Write" Binding="{Binding WriteText}" Width="100" SortMemberPath="WriteKbs"/>
                                    <DataGridTextColumn Header="Executable Path" Binding="{Binding Path}" Width="*" SortMemberPath="Path"/>
                                    <DataGridTemplateColumn Header="Protection" Width="100" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProtectionLabel}" Foreground="{Binding ProtectionColor}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ STARTUP ============ -->
            <TabItem Header="Startup">
                <DockPanel Margin="0,8,0,0">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBox x:Name="StartupSearch" Width="240" TextChanged="StartupSearch_TextChanged" ToolTip="Search startup item"/>
                            <ComboBox x:Name="StartupFilter" Width="160" Margin="10,0,0,0" SelectionChanged="StartupFilter_SelectionChanged"/>
                            <TextBlock x:Name="StartupCount" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <Separator Width="24"/>
                            <Button x:Name="BtnStartupSelectAll" Style="{StaticResource BtnPrimary}" Content="Select All" Click="BtnStartupSelectAll_Click"/>
                            <Button x:Name="BtnStartupEnableSel" Style="{StaticResource BtnGreen}" Content="Enable Selected" Click="BtnStartupEnableSel_Click"/>
                            <Button x:Name="BtnStartupDisableSel" Style="{StaticResource BtnRed}" Content="Disable Selected (Quarantine)" Click="BtnStartupDisableSel_Click"/>
                            <Button x:Name="BtnStartupColumns" Style="{StaticResource BtnPrimary}" Content="Columns ▾" Click="ColumnsButton_Click" Tag="{Binding ElementName=GridStartups}" ToolTip="Choose which columns are visible"/>
                        </WrapPanel>
                    </Border>

                    <DataGrid x:Name="GridStartups" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True" CanUserReorderColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="State" Width="110" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsOn, Mode=OneWay}" Style="{StaticResource ToggleSwitch}" ToolTip="{Binding ToggleTip}" Click="StartupRowToggle_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="36" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" SortMemberPath="Name"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="260" SortMemberPath="Location"/>
                            <DataGridTextColumn Header="Command / Target Path" Binding="{Binding Command}" Width="*" SortMemberPath="Command"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="160" SortMemberPath="StatusLabel"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ SERVICES ============ -->
            <TabItem Header="Services">
                <DockPanel Margin="0,8,0,0">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBox x:Name="SvcSearch" Width="240" TextChanged="SvcSearch_TextChanged" ToolTip="Search by name, display name or description"/>
                            <ComboBox x:Name="SvcFilter" Width="190" Margin="10,0,0,0" SelectionChanged="SvcFilter_SelectionChanged"/>
                            <TextBlock x:Name="SvcCount" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <Separator Width="24"/>
                            <Button x:Name="BtnSvcFilterGaming" Style="{StaticResource BtnPrimary}" Content="Gaming" Click="BtnSvcFilterGaming_Click" ToolTip="Show services recommended for gaming"/>
                            <Button x:Name="BtnSvcFilterWarn" Style="{StaticResource BtnPrimary}" Content="Caution" Click="BtnSvcFilterWarn_Click" ToolTip="Show services that require caution"/>
                            <Button x:Name="BtnSvcFilterOpt" Style="{StaticResource BtnPrimary}" Content="Optional" Click="BtnSvcFilterOpt_Click" ToolTip="Show optional services"/>
                            <Button x:Name="BtnSvcFilterAll" Style="{StaticResource BtnPrimary}" Content="All" Click="BtnSvcFilterAll_Click" ToolTip="Show all services"/>
                            <Separator Width="16"/>
                            <Button x:Name="BtnSvcSelectAll" Style="{StaticResource BtnPrimary}" Content="Select All (Editable)" Click="BtnSvcSelectAll_Click" ToolTip="Selects all visible non-protected services"/>
                            <Button x:Name="BtnSvcApplyGame" Style="{StaticResource BtnGreen}" Content="Apply Gaming Profile (1-Click)" Click="BtnSvcApplyGame_Click" ToolTip="Disables all recommended non-essential services for gaming"/>
                            <Button x:Name="BtnSvcRestoreBaseline" Style="{StaticResource BtnPrimary}" Content="Restore Baseline State" Click="BtnSvcRestoreBaseline_Click" ToolTip="Restores original service baseline"/>
                            <Separator Width="16"/>
                            <Button x:Name="BtnSvcEnableSel" Style="{StaticResource BtnGreen}" Content="Enable Selected" Click="BtnSvcEnableSel_Click"/>
                            <Button x:Name="BtnSvcDisableSel" Style="{StaticResource BtnRed}" Content="Disable Selected" Click="BtnSvcDisableSel_Click"/>
                            <Button x:Name="BtnSvcColumns" Style="{StaticResource BtnPrimary}" Content="Columns ▾" Click="ColumnsButton_Click" Tag="{Binding ElementName=GridServices}" ToolTip="Choose which columns are visible"/>
                        </WrapPanel>
                    </Border>

                    <DataGrid x:Name="GridServices" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True" CanUserReorderColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="State" Width="110" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsOn, Mode=OneWay}" Style="{StaticResource ToggleSwitch}" IsEnabled="{Binding CanTouch}" ToolTip="{Binding ToggleTip}" Click="SvcRowToggle_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="36" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" IsEnabled="{Binding CanTouch}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Service Name" Binding="{Binding Name}" Width="160" SortMemberPath="Name"/>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="240" SortMemberPath="DisplayName"/>
                            <DataGridTextColumn Header="Startup Type" Binding="{Binding StartKindLabel}" Width="130" SortMemberPath="StartKindLabel"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding RunningState}" Width="100" SortMemberPath="RunningState"/>
                            <DataGridTextColumn Header="Safety Risk" Binding="{Binding RiskLabel}" Width="180" SortMemberPath="RiskLabel"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130" SortMemberPath="Category"/>
                            <DataGridTextColumn Header="Description / Recommendation" Binding="{Binding Description}" Width="*" SortMemberPath="Description"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ SCHEDULED TASKS ============ -->
            <TabItem Header="Scheduled Tasks">
                <DockPanel Margin="0,8,0,0">
                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <WrapPanel>
                            <TextBox x:Name="TaskSearch" Width="240" TextChanged="TaskSearch_TextChanged" ToolTip="Search scheduled task"/>
                            <ComboBox x:Name="TaskFilter" Width="160" Margin="10,0,0,0" SelectionChanged="TaskFilter_SelectionChanged"/>
                            <TextBlock x:Name="TaskCount" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <Separator Width="24"/>
                            <Button x:Name="BtnTaskSelectAll" Style="{StaticResource BtnPrimary}" Content="Select All" Click="BtnTaskSelectAll_Click"/>
                            <Button x:Name="BtnTaskEnableSel" Style="{StaticResource BtnGreen}" Content="Enable Selected" Click="BtnTaskEnableSel_Click"/>
                            <Button x:Name="BtnTaskDisableSel" Style="{StaticResource BtnRed}" Content="Disable Selected" Click="BtnTaskDisableSel_Click"/>
                            <Button x:Name="BtnTaskColumns" Style="{StaticResource BtnPrimary}" Content="Columns ▾" Click="ColumnsButton_Click" Tag="{Binding ElementName=GridTasks}" ToolTip="Choose which columns are visible"/>
                        </WrapPanel>
                    </Border>

                    <DataGrid x:Name="GridTasks" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True" CanUserReorderColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="State" Width="110" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsOn, Mode=OneWay}" Style="{StaticResource ToggleSwitch}" ToolTip="{Binding ToggleTip}" Click="TaskRowToggle_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="36" CanUserSort="False" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Task Name" Binding="{Binding Name}" Width="240" SortMemberPath="Name"/>
                            <DataGridTextColumn Header="Full Path" Binding="{Binding FullPath}" Width="360" SortMemberPath="FullPath"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StateLabel}" Width="110" SortMemberPath="StateLabel"/>
                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*" SortMemberPath="Author"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============ OS TWEAKS ============ -->
            <TabItem Header="System Tweaks">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="System Clean &amp; Performance Utilities" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,4">
                                    <Button x:Name="BtnCleanJunk" Style="{StaticResource BtnPrimary}" Content="🧹 Clean Junk &amp; Temp Files" Click="BtnCleanJunk_Click" Margin="0,0,10,6" Padding="12,6" ToolTip="Scans and removes temporary files, Prefetch, and DirectX Shader caches"/>
                                    <Button x:Name="BtnTrimRam" Style="{StaticResource BtnGreen}" Content="⚡ Free Up RAM (Trim Working Set)" Click="BtnTrimRam_Click" Margin="0,0,10,6" Padding="12,6" ToolTip="Frees inactive working set RAM from background processes"/>
                                    <Button x:Name="BtnFlushDns" Style="{StaticResource BtnAccent}" Content="🌐 Flush DNS Cache" Click="BtnFlushDns_Click" Margin="0,0,10,6" Padding="12,6" ToolTip="Clears Windows DNS resolver cache to fix connection latencies"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="System Fine-Tuning Tweaks (All Reversible)" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Button x:Name="BtnTweakColumns" Style="{StaticResource BtnPrimary}" Content="Columns ▾" HorizontalAlignment="Left" Margin="0,0,0,8" Click="ColumnsButton_Click" Tag="{Binding ElementName=GridTweaks}" ToolTip="Choose which columns are visible"/>
                                <DataGrid x:Name="GridTweaks" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="True" CanUserReorderColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Actions" Width="160" CanUserSort="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Apply" Style="{StaticResource BtnGreen}" FontSize="11" Padding="6,3" Margin="0,0,4,0" Click="TweakApply_Click"/>
                                                        <Button Content="Revert" Style="{StaticResource BtnPrimary}" FontSize="11" Padding="6,3" Click="TweakRevert_Click"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Tweak" Binding="{Binding Name}" Width="260" SortMemberPath="Name"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="470" SortMemberPath="Description"/>
                                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110" SortMemberPath="State"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ PROFILES ============ -->
            <TabItem Header="Profiles">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,0">

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button x:Name="BtnViewToggle" Content="View as List" Style="{StaticResource BtnPrimary}" Click="BtnViewToggle_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnProfileCreate" Content="+ Create New Profile" Style="{StaticResource BtnGreen}" Click="BtnProfileCreate_Click"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Optimization Profiles" FontSize="15" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Active profile: " Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="TxtCurrentProfile" Text="Default" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <Button x:Name="BtnSaveProfile" Style="{StaticResource BtnGreen}" HorizontalAlignment="Left" Padding="14,8" Click="BtnSaveProfile_Click" Margin="0,0,0,12" ToolTip="Saves current system configuration into active profile">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Save Current State" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <!-- Cards View -->
                                <ItemsControl x:Name="ProfileCards" Visibility="Visible">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="340" Margin="0,0,12,12" Padding="14" Style="{StaticResource Card}">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,6">
                                                        <Border Background="#2563EB" CornerRadius="4" Padding="6,2" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" DockPanel.Dock="Right">
                                                            <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{StaticResource TextDim}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding CreatedLabel}" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                                    <TextBlock Text="{Binding SavedLabel}" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,10"/>

                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Button Content="Select" Style="{StaticResource BtnPrimary}" FontSize="11" Padding="8,4" Margin="0,0,6,6" Click="BtnProfileSelect_Click" ToolTip="Sets this profile as active"/>
                                                        <Button Content="Apply State" Style="{StaticResource BtnGreen}" FontSize="11" Padding="8,4" Margin="0,0,6,6" Click="BtnProfileApply_Click" ToolTip="Applies all saved configurations from this profile"/>
                                                        <Button Content="Overwrite Save" Style="{StaticResource BtnPrimary}" FontSize="11" Padding="8,4" Margin="0,0,6,6" Click="BtnProfileSaveHere_Click" ToolTip="Saves current system configuration to this profile"/>
                                                        <Button Content="Delete" Style="{StaticResource BtnRed}" FontSize="11" Padding="8,4" Margin="0,0,0,6" Click="BtnProfileDelete_Click" IsEnabled="{Binding IsDefault, Converter={StaticResource InverseBool}}" ToolTip="Deletes custom profile"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Grid List View -->
                                <DataGrid x:Name="GridProfiles" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" Visibility="Collapsed" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Actions" Width="300">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Select" Style="{StaticResource BtnPrimary}" FontSize="11" Padding="6,3" Margin="0,0,4,0" Click="BtnProfileSelect_Click"/>
                                                        <Button Content="Apply" Style="{StaticResource BtnGreen}" FontSize="11" Padding="6,3" Margin="0,0,4,0" Click="BtnProfileApply_Click"/>
                                                        <Button Content="Save Here" Style="{StaticResource BtnPrimary}" FontSize="11" Padding="6,3" Margin="0,0,4,0" Click="BtnProfileSaveHere_Click"/>
                                                        <Button Content="Delete" Style="{StaticResource BtnRed}" FontSize="11" Padding="6,3" Click="BtnProfileDelete_Click" IsEnabled="{Binding IsDefault, Converter={StaticResource InverseBool}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Profile Name" Binding="{Binding Name}" Width="160"/>
                                        <DataGridTextColumn Header="Description / Role" Binding="{Binding Subtitle}" Width="260"/>
                                        <DataGridTextColumn Header="Created At" Binding="{Binding CreatedLabel}" Width="180"/>
                                        <DataGridTextColumn Header="Last Save" Binding="{Binding SavedLabel}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- System Restore Section -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Windows System Restore Points" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock Text="System Restore Points capture full Windows Registry and system files state before modifications. Creation and restoration take seconds." Margin="0,0,0,12" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>

                                <WrapPanel Margin="0,0,0,12">
                                    <Button x:Name="BtnRpCreate" Style="{StaticResource BtnGreen}" Content="+ Create Restore Point" Click="BtnRpCreate_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnRpRefresh" Style="{StaticResource BtnPrimary}" Content="Refresh List" Click="BtnRpRefresh_Click"/>
                                </WrapPanel>

                                <DataGrid x:Name="GridRestorePoints" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" MaxHeight="240">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Actions" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="Restore PC" Style="{StaticResource BtnRed}" FontSize="11" Padding="6,3" Margin="0,0,4,0" Click="BtnRpRestore_Click" ToolTip="Restores Windows to this point"/>
                                                        <Button Content="Delete" Style="{StaticResource BtnPrimary}" FontSize="11" Padding="6,3" Click="BtnRpDelete_Click" ToolTip="Deletes restore point"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="60"/>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="320"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding RestorePointType}" Width="160"/>
                                        <DataGridTextColumn Header="Created Date/Time" Binding="{Binding CreationTime}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

    </DockPanel>
    </Border>
</Window>
