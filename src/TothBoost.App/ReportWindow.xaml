<Window x:Class="TothBoost.App.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resultado da operação" Width="760" Height="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg0}" FontSize="13">
    <Border Background="{StaticResource Bg0}">
    <DockPanel Margin="12">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,0,0,10"/>
        <Button x:Name="BtnClose" DockPanel.Dock="Bottom" Content="Fechar" Style="{StaticResource BtnPrimary}" Width="120" HorizontalAlignment="Right" Margin="0,12,0,0" Click="BtnClose_Click"/>
        <ListView x:Name="ListReport" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1" FontSize="12">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <TextBlock Text="{Binding Icon}" Width="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Item}" Width="160" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Action}" Width="190" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
    </Border>
</Window>