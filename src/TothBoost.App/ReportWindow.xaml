<Window x:Class="TothBoost.App.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resultado da operação" Width="760" Height="560" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg0}" FontSize="13">
    <Border Background="{StaticResource Bg0}">
    <DockPanel Margin="12">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,0,0,10"/>
        <Button x:Name="BtnClose" DockPanel.Dock="Bottom" Content="Fechar" Style="{StaticResource BtnPrimary}" Width="120" HorizontalAlignment="Right" Margin="0,12,0,0" Click="BtnClose_Click"/>
        <ListView x:Name="ListReport" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1" FontSize="12">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="44">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Icon}" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Serviço" Width="280">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Item}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Ação" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Action}" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Detalhe" Width="400">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
    </Border>
</Window>